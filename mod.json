{
	"geode": "5.11.2",
	"gd": {
		"android": "2.2081",
		"win": "2.2081"
	},
	"version": "v1.0.0",
	"id": "custom.ai_editor_assistant",
	"name": "AI Editor Assistant",
	"developer": "CustomCreator",
	"description": "Русскоязычный ИИ-помощник со зрением и управлением в редакторе уровней",
	"resources": {
		"sprites": [
			"resources/brain.png"
		],
		"fonts": [
			"resources/ru_font.ttf"
		]
	},
	"settings": {
		"provider": {
			"type": "string",
			"name": "Провайдер ИИ",
			"description": "Выбери сервис стрелочками",
			"default": "Cloudflare",
			"one-of": [
				"Cloudflare",
				"Pollinations",
				"VseGPT",
				"OpenRouter"
			]
		},
		"cf-account-id": {
			"type": "string",
			"name": "Cloudflare Account ID",
			"description": "32 символа (только буквы и цифры, нужен для Cloudflare)",
			"default": "",
			"filter": "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
		},
		"api-key": {
			"type": "string",
			"name": "API Ключ (Token)",
			"description": "Твой API-ключ (для Pollinations впиши free)",
			"default": "",
			"filter": "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_."
		},
		"model-preset": {
			"type": "string",
			"name": "Модель ИИ",
			"description": "Выбери модель стрелочками (все спецсимволы подставятся сами)",
			"default": "Cloudflare Llama 3.2 Vision",
			"one-of": [
				"Cloudflare Llama 3.2 Vision",
				"Cloudflare Llama 3.1 8B",
				"Pollinations OpenAI",
				"VseGPT GPT-4o-mini",
				"OpenRouter Free"
			]
		}
	}
}
